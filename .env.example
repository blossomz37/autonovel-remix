# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Writer model (used for drafting and revision)
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6

# Judge model (used for evaluation — should differ from writer)
AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6

# Review model (Opus — deep prose-level analysis, used in Phase 3b)
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# API base URL
AUTONOVEL_API_BASE_URL=https://api.anthropic.com

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Midjourrney API
# Get from https://midjourney-api.com/dashboard/overview
MIDJOURNEY_API_KEY=your-midjourney-api-key-here

# Openrouter API
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Openrouter Preferred Models
# Get from https://openrouter.ai/models?output_modalities=image
OPENROUTER_IMAGEGEN=your-preferred-image-generation-model-here
OPENROUTER_IMAGEGEN_FALLBACK=your-fallback-image-generation-model-here

# OpenAI API
OPENAI_API_KEY=your-openai-key-here

# Reasoning & Verbosit Settings
# Can be "xhigh", "high", "medium", "low", "minimal" or "none" (OpenAI-style)
OPENROUTER_REASONING_EFFORT="none"
# Specific token limit (Anthropic-style)
OPENROUTER_REASONING_MAX_TOKENS=0
# Optional: Default is false. All models support this.
# Set to true to exclude reasoning tokens from response
OPENROUTER_REASONING_EXCLUDE=true
# Or enable reasoning with the default parameters:
# Default: inferred from `effort` or `max_tokens`
OPENROUTER_REASONING_ENABLED=false 
# Key: verbosity
# Optional, enum (low, medium, high, xhigh, max)
# Default: medium
OPENROUTER_VERBOSITY="low"